# Copy to local.env (gitignored). No tokens here.
OBSIDIAN_VAULT=/absolute/path/to/your/Obsidian/vault
# Optional Notion paste-inbox (scripts/notion-extract-inbox.py).
# Schema and ping rules: docs/paste-inbox.md — do not put cookies on a remote poller.
# NOTION_DATABASE_ID=
# NOTION_DATA_SOURCE_ID=
# Token stays in NOTION_TOKEN or notion.env — never commit either.

# Optional existing shared String JSONL usage report (no credentials).
# STRING_USAGE_LEDGER=/path/to/string-usage.jsonl
